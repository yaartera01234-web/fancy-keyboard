<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="4dp">

    <!-- TOOLBAR -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="TOGGLE" android:text="👑" style="@style/KbTool" />
        <Button android:tag="CLIP" android:text="📋" style="@style/KbTool" />
        <Button android:tag="HIDE" android:text="⌨️" style="@style/KbTool" />
        <View android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="6" />
    </LinearLayout>

    <!-- Emoji categories are filled from the Unicode catalog in FancyIME.kt. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">
        <LinearLayout
            android:id="@+id/emoji_categories"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <Button android:tag="EMOJI_PREV" android:text="‹" style="@style/KbTool" />
        <TextView
            android:id="@+id/emoji_page_label"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="😀 1/1"
            android:textColor="#C4B5FD"
            android:textSize="13sp" />
        <Button android:tag="EMOJI_NEXT" android:text="›" style="@style/KbTool" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/emoji_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="8"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false" />

    <!-- BOTTOM -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="ABC" android:text="ABC" style="@style/KbKeyWideDark" />
        <Button android:tag="SPACE" android:text="space" style="@style/KbKeySpace" />
        <Button android:tag="BACK" android:text="⌫" style="@style/KbKeyWideDark" />
    </LinearLayout>

</LinearLayout>
