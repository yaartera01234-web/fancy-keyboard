<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="4dp">

    <!-- TOOLBAR -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="TOGGLE" android:text="👑" style="@style/KbTool" />
        <Button android:tag="CLIP" android:text="📋" style="@style/KbTool" />
        <Button android:tag="HIDE" android:text="⌨️" style="@style/KbTool" />
        <View android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="6" />
    </LinearLayout>

    <!-- ROW 1: numbers -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="1" android:text="1" style="@style/KbKey" />
        <Button android:tag="2" android:text="2" style="@style/KbKey" />
        <Button android:tag="3" android:text="3" style="@style/KbKey" />
        <Button android:tag="4" android:text="4" style="@style/KbKey" />
        <Button android:tag="5" android:text="5" style="@style/KbKey" />
        <Button android:tag="6" android:text="6" style="@style/KbKey" />
        <Button android:tag="7" android:text="7" style="@style/KbKey" />
        <Button android:tag="8" android:text="8" style="@style/KbKey" />
        <Button android:tag="9" android:text="9" style="@style/KbKey" />
        <Button android:tag="0" android:text="0" style="@style/KbKey" />
    </LinearLayout>

    <!-- ROW 2: symbols (Gboard!) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="@" android:text="@string/at_sign" style="@style/KbKey" />
        <Button android:tag="#" android:text="#" style="@style/KbKey" />
        <Button android:tag="$" android:text="$" style="@style/KbKey" />
        <Button android:tag="_" android:text="_" style="@style/KbKey" />
        <Button android:tag="&amp;" android:text="&amp;" style="@style/KbKey" />
        <Button android:tag="-" android:text="-" style="@style/KbKey" />
        <Button android:tag="+" android:text="+" style="@style/KbKey" />
        <Button android:tag="(" android:text="(" style="@style/KbKey" />
        <Button android:tag=")" android:text=")" style="@style/KbKey" />
        <Button android:tag="/" android:text="/" style="@style/KbKey" />
    </LinearLayout>

    <!-- ROW 3 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="SYMPAGE" android:text="=\&lt;" style="@style/KbKeyWideDark" />
        <Button android:tag="*" android:text="*" style="@style/KbKey" />
        <Button android:tag="&quot;" android:text="&quot;" style="@style/KbKey" />
        <Button android:tag="'" android:text="'" style="@style/KbKey" />
        <Button android:tag=":" android:text=":" style="@style/KbKey" />
        <Button android:tag=";" android:text=";" style="@style/KbKey" />
        <Button android:tag="!" android:text="!" style="@style/KbKey" />
        <Button android:tag="?" android:text="@string/qmark" style="@style/KbKey" />
        <Button android:tag="BACK" android:text="⌫" style="@style/KbKeyWideDark" />
    </LinearLayout>

    <!-- ROW 4 -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:tag="ABC" android:text="ABC" style="@style/KbKeyWideDark" />
        <Button android:tag="," android:text="," style="@style/KbKey" />
        <Button android:tag="SYMPAGE" android:text="12\n34" android:textSize="13sp" style="@style/KbKey" />
        <Button android:tag="SPACE" android:text="space" style="@style/KbKeySpace" />
        <Button android:tag="." android:text="." style="@style/KbKey" />
        <Button android:tag="ENTER" android:text="⏎" style="@style/KbKeyWideAccent" />
    </LinearLayout>

</LinearLayout>
