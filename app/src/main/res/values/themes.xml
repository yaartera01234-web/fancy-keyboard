<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FancyKeyboard" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#0f0c29</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textColorPrimary">#ffffff</item>
    </style>

    <!-- letter keys (Gboard size! 📐) -->
    <style name="KbKey" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:background">@drawable/key_bg</item>
    </style>
    <!-- dark keys (shift/backspace/?123) -->
    <style name="KbKeyDark" parent="KbKey">
        <item name="android:background">@drawable/key_bg_dark</item>
    </style>
    <!-- purple enter! 💜 -->
    <style name="KbKeyAccent" parent="KbKey">
        <item name="android:background">@drawable/key_bg_accent</item>
    </style>
    <style name="KbKeyWide" parent="KbKey">
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="KbKeyWideDark" parent="KbKeyDark">
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="KbKeyWideAccent" parent="KbKeyAccent">
        <item name="android:layout_weight">1.5</item>
    </style>
    <style name="KbKeySpace" parent="KbKey">
        <item name="android:layout_weight">4</item>
        <item name="android:textSize">14sp</item>
    </style>
    <!-- toolbar keys (👑 📋 ⌨️) -->
    <style name="KbTool" parent="KbKey">
        <item name="android:layout_height">38dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:background">@drawable/key_bg_dark</item>
    </style>
    <!-- suggestion strip words ✨ -->
    <style name="KbSug">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">false</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
    <!-- emoji keys 😀 -->
    <style name="KbEmoji" parent="KbKey">
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:textSize">24sp</item>
    </style>
</resources>
